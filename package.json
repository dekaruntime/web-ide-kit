{
  "name": "@dekaruntime/web-ide-kit",
  "version": "0.1.9",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dekaruntime/web-ide-kit.git"
  },
  "exports": {
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "copy-deka-monaco": "bin/copy-monaco-assets.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "copy-monaco": "node bin/copy-monaco-assets.mjs",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@radix-ui/react-slot": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.400.0 || ^1.0.0",
    "monaco-editor": "*",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.0.0 || ^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
